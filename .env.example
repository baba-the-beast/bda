# =============================================================================
# Energy Analytics Platform - Environment Configuration Template
# NOTE: Never commit real production secrets to version control.
# =============================================================================

# Public / Core Networking
NODE_ENV=development
LOG_LEVEL=INFO
PORT_GATEWAY=8000
PORT_AUTH=8001
PORT_DATASET=8002
PORT_PREPROCESS=8003
PORT_ORCHESTRATOR=8004
PORT_HIVE=8005
PORT_ANALYTICS=8006
PORT_STREAM=8007
PORT_FRONTEND=3000

# Security & Authentication
JWT_SECRET=change-this-to-a-secure-random-32-byte-hex-string-for-production!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=bda.energy.platform
JWT_AUDIENCE=bda.energy.clients
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# Database Persistence (MongoDB 7.0)
MONGO_URI=mongodb://bda_app:bda_secure_pass_2026@localhost:27017/bda_energy?authSource=admin
MONGO_DB_NAME=bda_energy

# Caching & Rate Limiting (Redis 7.2)
REDIS_URL=redis://:redis_secure_pass_2026@localhost:6379/0

# Distributed Storage (Hadoop HDFS)
HDFS_MODE=auto
LOCAL_HDFS_ROOT=data/hdfs
WEBHDFS_URL=http://localhost:9870/webhdfs/v1
HADOOP_HOME=/opt/hadoop

# Apache Hive / HiveServer2
HIVE_SERVER_HOST=localhost
HIVE_SERVER_PORT=10000
HIVE_DATABASE=bda_energy

# Streaming Event Bus (Apache Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=energy-events

# Distributed Compute (Apache Spark)
SPARK_MASTER_URL=spark://localhost:7077

# Benchmark & Execution Safeguards
RATE_LIMIT_MAX_RPM=150
MAX_UPLOAD_SIZE_MB=250
