# Python build artefacts. Anchored with a leading slash: unanchored, these
# match any directory of the same name at any depth, and `lib/` silently
# excluded frontend/src/lib/.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/env/
venv/
.venv/
/build/
/develop-eggs/
dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
.npm/
frontend/playwright-report/
frontend/test-results/
frontend/coverage/

# Large Datasets and Extracted Files
data/raw/*.txt
data/raw/*.csv
data/hdfs/user/bda/energy/raw/*
data/hdfs/user/bda/energy/cleaned/*
data/hdfs/user/bda/energy/output/*
data/hdfs/user/bda/energy/rejected/*
*.log
*.zip

# Environment & Secrets
.env
.env.local
.env.production
