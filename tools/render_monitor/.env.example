# Render keep-alive monitor configuration.
# Copy to tools/render_monitor/.env (git-ignored) or export these in the
# environment of the machine running the monitor. Real environment variables
# take precedence over this file. No secrets are needed: /health is public.

# Required: the deployed backend's public URL (no trailing path, no credentials).
RENDER_URL=https://YOUR-APP.onrender.com

# Endpoint appended to RENDER_URL. The backend already serves /health.
HEALTH_PATH=/health

# Minutes between checks (1-1440). Render's free tier idles after ~15 minutes.
PING_INTERVAL_MINUTES=10

# Per-request timeout. Cold starts on the free tier can take close to a minute.
REQUEST_TIMEOUT_SECONDS=30

# Extra attempts after a network error, timeout, 5xx or 429 (0-5), with
# exponential backoff: RETRY_BACKOFF_SECONDS, then 2x, 4x, ...
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=2

# Log a statistics summary every N checks (0 disables; always logged on shutdown).
STATS_EVERY_N_CHECKS=6

# Optional local JSON status endpoint (GET /status). Leave empty to disable.
STATUS_PORT=
STATUS_HOST=127.0.0.1

# text (one line per check) or json (one JSON object per line).
LOG_FORMAT=text
